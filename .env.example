# PARALLAX — frontend API configuration
# Copy to .env.local (gitignored) and adjust for your environment.

# ---- PARALLAX backend (Bani) ----
# SQLite target. Relative paths resolve from the repo root.
# Default: file:./server/data/parallax.db
DATABASE_URL=file:./server/data/parallax.db

# HTTP port for the backend API (default 8000).
PORT=8000

# Allowed CORS origin for the frontend (default "*").
CORS_ORIGIN=*

# Base URL of the PARALLAX backend (Bani). Leave unset for pure demo mode (mock only).
VITE_API_BASE_URL=http://localhost:8000

# Force mock responses even when a base URL is configured ("true"/"false").
VITE_API_MOCK_MODE=false

# When the backend is unreachable, fall back to mock data instead of erroring ("true"/"false").
VITE_API_FALLBACK_TO_MOCK=true

# Fetch timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Optional per-module overrides — paths are appended to VITE_API_BASE_URL.
# Master data + health (Bani)
VITE_API_MASTER_URL=/api
VITE_API_HEALTH_URL=/api/health
# Disruptions (Bani)
VITE_API_DISRUPTIONS_URL=/api/disruptions
# Capability Graph Engine (Suvreen)
VITE_API_GRAPH_URL=/api/graph
# Recovery engine + approvals (Diya / Bani)
VITE_API_RECOVERY_URL=/api/recovery
# Simulation engine — "Break My Supply Chain" (Diya)
VITE_API_SIMULATION_URL=/api/simulation
# Agentic AI Orchestrator (Riya)
VITE_API_AGENTS_URL=/api/agents

# ---- LLM (provider: Groq) ----
# The LLM is always called from the backend; keys are never bundled into the
# frontend. Copy these into your local SERVER environment (.env.local / shell).
# Leave unset to run without AI (the app degrades gracefully).
GROQ_API_KEY=
PARALLAX_LLM_MODEL=llama-3.3-70b-versatile
PARALLAX_LLM_TIMEOUT_MS=8000
# Set to "false" to disable all LLM calls entirely.
PARALLAX_LLM_ENABLED=true
